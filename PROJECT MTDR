local function SetActivePropType(propName, category)
    category = category or "Building"
    
    local remotesFolder = ReplicatedStorage:WaitForChild("Remotes", 5)
    local reFolder = ReplicatedStorage:WaitForChild("RE", 5)

    if remotesFolder and remotesFolder:FindFirstChild("TelemetryClientInteraction") then
        pcall(function()
            remotesFolder.TelemetryClientInteraction:FireServer("filterClick", {["name"] = category, ["itemType"] = "Props"})
            task.wait(0.02)
            remotesFolder.TelemetryClientInteraction:FireServer("filterClick", {["name"] = propName, ["itemType"] = "Props"})
        end)
    end

    if reFolder and reFolder:FindFirstChild("1Clea1rTool1s") then
        pcall(function()
            reFolder["1Clea1rTool1s"]:FireServer("RequestingPropName", propName, category)
        end)
    end

    task.wait(0.03)
end

local function EnsurePropMakerTool()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local backpack = LocalPlayer:WaitForChild("Backpack")
    
    local tool = character:FindFirstChild("PropMaker") or backpack:FindFirstChild("PropMaker")
    if not tool then
        pcall(function()
            ReplicatedStorage:WaitForChild("RE"):WaitForChild("1Too1l"):InvokeServer("PickingTools", "PropMaker")
        end)
        task.wait(0.15)
        tool = character:FindFirstChild("PropMaker") or backpack:FindFirstChild("PropMaker")
    end

    if tool and tool.Parent ~= character then
        tool.Parent = character
        task.wait(0.1)
    end

    return tool and tool:WaitForChild("Tool_PropMake", 4)
end

local function AplicarCorProp(propModel, color3Value)
    if not propModel then return end
    
    local colorString = string.format("%%f, %%f, %%f", color3Value.R, color3Value.G, color3Value.B)
    local reFolder = ReplicatedStorage:FindFirstChild("RE")

    local changeColorRF = propModel:FindFirstChild("ChangePropColor") or propModel:FindFirstChild("SetPropColor")
    if changeColorRF and changeColorRF:IsA("RemoteFunction") then
        pcall(function() changeColorRF:InvokeServer(colorString) end)
        pcall(function() changeColorRF:InvokeServer(color3Value) end)
    end

    if reFolder then
        local editRemote = reFolder:FindFirstChild("PickerEditProp") or reFolder:FindFirstChild("1Edit1Prop")
        if editRemote then
            if editRemote:IsA("RemoteFunction") then
                pcall(function() editRemote:InvokeServer(propModel, "Color", color3Value) end)
                pcall(function() editRemote:InvokeServer(propModel, "Color", colorString) end)
            elseif editRemote:IsA("RemoteEvent") then
                pcall(function() editRemote:FireServer(propModel, "Color", color3Value) end)
                pcall(function() editRemote:FireServer(propModel, "Color", colorString) end)
            end
        end
    end
end

local function Create(className, parent, properties, corner, stroke)
    local obj = Instance.new(className)
    for k, v in pairs(properties) do obj[k] = v end
    if corner then Instance.new("UICorner", obj).CornerRadius = UDim.new(0, corner) end
    if stroke then
        local str = Instance.new("UIStroke", obj)
        for k, v in pairs(stroke) do str[k] = v end
    end
    if parent then obj.Parent = parent end 
    return obj
end

