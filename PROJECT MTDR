-- FUNÇÃO DO EXECUTOR (Loadstring + Proteção pcall)
BtnExect.MouseButton1Click:Connect(function()
    local codigo = CodeInputBox.Text
    
    if codigo and codigo:gsub("%s+", "") ~= "" then
        local funcaoCompilada, erroDeSintaxe = loadstring(codigo)
        
        if funcaoCompilada then
            local sucesso, erroDeExecucao = pcall(funcaoCompilada)
            if sucesso then
                print("[EXECUTOR]: Código executado com sucesso!")
            else
                warn("[EXECUTOR - ERRO DE EXECUÇÃO]: " .. tostring(erroDeExecucao))
            end
        else
            warn("[EXECUTOR - ERRO DE SINTAXE]: " .. tostring(erroDeSintaxe))
        end
    else
        warn("[EXECUTOR]: O painel de texto está vazio!")
    end
end)

