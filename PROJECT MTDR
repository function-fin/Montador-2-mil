local function ExecutarInvokeProps()
    task.spawn(function()
        BtnInvokeProps.Text = "EQUIPANDO..."
        SetInvokeConcluido(false)

        local target_base = workspace:FindFirstChild("Baseplate") or workspace.Terrain
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local toolPropMake = EnsurePropMakerTool()
        if not toolPropMake then
            BtnInvokeProps.Text = "ERRO: TOOL NAO ENCONTRADA"
            task.wait(1.5)
            BtnInvokeProps.Text = "INVOKE PROPS"
            return
        end

        local totalProps = #EstrelaLayout
        local centerPos = hrp.Position + Vector3.new(0, -2, 0)
        local radius = 20

        for index = 1, totalProps do
            local propConfig = EstrelaLayout[index]
            BtnInvokeProps.Text = string.format("INVOCANDO %%d/%%d...", index, totalProps)

            SetActivePropType(propConfig.PropId, propConfig.Categoria)
            toolPropMake = EnsurePropMakerTool()

            local angle = (index / totalProps) * (math.pi * 2)
            local offset = Vector3.new(math.sin(angle) * radius, 0, math.cos(angle) * radius)
            local spawnPoint = centerPos + offset

            if toolPropMake then
                pcall(function() 
                    toolPropMake:FireServer(target_base, spawnPoint) 
                end)
            end

            local propRemotes = {}
            local timeout = 0
            repeat
                task.wait(0.03)
                timeout = timeout + 0.03
                propRemotes = getOrganizedProps()
            until #propRemotes >= index or timeout >= 0.6

            if propRemotes[index] and propRemotes[index].Parent then
                local propModel = propRemotes[index].Parent
                if propConfig.Color then
                    AplicarCorProp(propModel, propConfig.Color)
                end
            end

            task.wait(TEMPO_SPAWN_PROP - 0.03)
        end

        BtnInvokeProps.Text = "INVOKE PROPS"
        SetInvokeConcluido(true)
    end)
end

BtnInvokeProps.MouseButton1Click:Connect(ExecutarInvokeProps)
BtnPositivoInvoke.MouseButton1Click:Connect(ExecutarInvokeProps)

