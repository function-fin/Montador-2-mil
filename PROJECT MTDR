local function ExecutarConstrucao()
    if roboAtivo then
        stopRobot()
        BtnConstruir.Text = "Construir Structure"
        SetConstruirConcluido(false)
        BtnGiveLight.Text = "Give Light (off)"
        SetGiveLightConcluido(false)
        return
    end

    task.spawn(function()
        stopRobot()
        BtnConstruir.Text = "MAPEANDO..."
        
        local propRemotes = getOrganizedProps()
        local totalInvocados = #propRemotes

        if totalInvocados == 0 then
            BtnConstruir.Text = "NENHUM PROP DETECTADO"
            task.wait(1.5)
            BtnConstruir.Text = "Construir Structure"
            return
        end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        baseMontagemCF = hrp.CFrame
        currentSmoothCF = baseMontagemCF
        roboAtivo = true
        seguiAtivo = false
        lastSend = 0

        -- Utiliza PostSimulation acoplado com interpolação suave
        loopThread = RunService.PostSimulation:Connect(function(deltaTime)
            if not roboAtivo then
                if loopThread then loopThread:Disconnect() end
                return
            end

            local currentTime = os.clock()
            if currentTime - lastSend < SEND_INTERVAL then return end
            lastSend = currentTime

            local currentHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local targetBaseCF = seguiAtivo and currentHRP and currentHRP.CFrame or baseMontagemCF

            if targetBaseCF then
                -- Interpolação (Lerp) para movimentos mais suaves ao andar
                if not currentSmoothCF then currentSmoothCF = targetBaseCF end
                currentSmoothCF = currentSmoothCF:Lerp(targetBaseCF, math.clamp(deltaTime * 25, 0.15, 1))

                local rot3D = CFrame.Angles(math.rad(rotX), math.rad(rotY), math.rad(rotZ))

                -- Atualização assíncrona com task.spawn de todas as peças
                for i = 1, totalInvocados do
                    local remote = propRemotes[i]
                    local config = EstrelaLayout[i]

                    if remote and config then
                        local finalCF = currentSmoothCF * rot3D * config.CFrameToPlayer

                        task.spawn(function()
                            pcall(function() remote:InvokeServer(finalCF) end)
                        end)
                    end
                end
            end
        end)

        BtnConstruir.Text = "Construir Structure"
        SetConstruirConcluido(true)
    end)
end

BtnConstruir.MouseButton1Click:Connect(ExecutarConstrucao)
BtnPositivoConstruir.MouseButton1Click:Connect(ExecutarConstrucao)

